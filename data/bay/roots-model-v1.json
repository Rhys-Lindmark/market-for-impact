{
  "model_id": "roots-whole-gift-bp-v1",
  "prepared": "September 8, 2026",
  "status": "Independently audited conditional research model",
  "case_mix_cost_definition": "Five-year risk describes the selected high-risk course cohort, not all referrals. Course cash includes allocated screening, ineligible candidates and failed engagement; no second selection-yield or adherence multiplier. Start delay shifts both events and clipping window. Extra resource costs exclude items already included in donor cash.",
  "organization": {
    "name": "Roots Community Health",
    "ein": "26-2583954",
    "official_identity": "https://rootscommunityhealth.org/donate/",
    "scope": "California recipient, not Seattle Roots or Philippines Roots of Health"
  },
  "boundary": "One unrestricted gift, only BP component quantified; other portfolio costs retained, benefits unquantified. Not an observed whole-organization impact estimate.",
  "assumptions": "Every numerical input except RR0.80 per10mmHg and gift scenario size is an analyst judgment. Five-year direct cash reserved at gift, no follow-on gifts assumed. Additional gross resource allowance is unpriced stress, not observed payer contribution.",
  "formula": "RR=.8^(SBP/10); R1=R0*RR. Annual conditional first-event risks p0=1-(1-R0)^(1/5),p1=1-(1-R1)^(1/5). Year j difference=(1-p0)^(j-1)*p0-(1-p1)^(j-1)*p1. Postevent annual health starts one year after each event, finite horizons; event at j-.5 after course start. Q=N*A*(sum(deltaEvent_j*discountedTail_j)-sharedHarm)-independentHarm. Negative annual differences, if any, are retained.",
  "finite_caveat": "Core treats prevented first events during five years as having durable finite consequences. Later catch-up unmodeled; clip sensitivities end all health at care year5. No BP benefit after year5. Pre-event competing death omitted because R0 is specified cumulative incidence; postevent survival5% annual is judgment.",
  "funding": "A addresses replacement of funded activity; achieved SBP difference is conditional implementation versus actual available usual care and incorporates uptake/adherence. Do not additionally multiply insurance noncoverage or adherence. Public overlap can lower both but they are conceptually distinct.",
  "harm": "Shared harm is all-recipient discounted-at-gift QALY burden per offered course before funding additionality; independent donor harm applies even at A0. Both follow scenario geography. Other morbidity streams unquantified, not guaranteed nonnegative.",
  "resources": "Gift + N*extra_resource_usd_per_course is gross associated operating envelope, counting all offers including failures. No claim of net incremental societal cost; family time omitted.",
  "geography": "All modeled health is US. Bay is resident share prior, SF subset zero quantified credit pending evidence, not absence claim. Nested ledgers not added.",
