{
  "schema_version": "conditional-policy-portfolio-v1",
  "model_id": "cca-whole-gift-charging-v1",
  "prepared_at": "2026-09-08",
  "status": "Conditional research draft for independent audit; no demonstrated marginal donation offer",
  "organization": {
    "name": "Coalition for Clean Air",
    "ein": "23-7120567",
    "donation_url": "https://ccair.app.neoncrm.com/forms/donate",
    "scope": "California-wide whole unrestricted portfolio; only future charging/clean-fleet operation health quantified"
  },
  "basis": "Current CCA July 2026 CEC participation motivates prospective staff work. Every causal capacity, allocation, timing, cost, survival and geography input is an analyst prior. A 2019 CARB ACT zero-emission-vs-ICE forecast supplies only a coarse matched health order-of-magnitude anchor: 18 annual deaths in 2030 divided by roughly 60,000 ZEVs visually estimated from fleet figure. This is not measured per-truck health, not a current regulation forecast and not credit for ACT passage. Transfer factor addresses timing, cleaner modern diesel, grid/duty-cycle and exposure mismatch; not a calibrated combined correction.",
  "formula": {
    "staff": "G*charging_fraction/staff_year_cash",
    "changed_decisions": "staff*opportunities_per_staff_year*incremental_change_probability*funding_additionality",
    "vehicles": "changed_decisions*vehicles_per_changed_decision*enabled_clean_operation_fraction",
    "displaced_vehicles": "changed_decisions*vehicles_per_changed_decision*displaced_equivalent_vehicle_fraction",
    "health": "(target_vehicles*target_region_share-displaced_vehicles*displaced_region_share)*deaths_per_vehicle_year*transfer*finite_survival_tail*sum_j(discount to midpoint of each acceleration year) - independent_harm*harm_region_share",
    "public_cost": "changed_decisions*(target_public_real_cost-displaced_public_real_cost)",
    "net_resource": "G+expected_net_public_real_cost+expected_net_private_real_cost"
  },
  "definitions": {
    "incremental_change_probability": "Chance one prospective distinct decision changes because of added CCA work, conditional on other coalition and public activity. Already marginal CCA attribution: never multiply a second coalition credit. Distinct decision opportunities must not refer to the same project.",
    "funding_additionality": "Whether extra staff work occurs instead of replacing other support; not a second coalition or clinical counterfactual adjustment.",
    "enabled_clean_operation_fraction": "Share of project vehicles whose clean use is actually brought forward; includes charging utilization, vehicle availability, attrition and already-committed adoption. Not installation counts.",
    "displacement": "Lost alternative-project health as equivalent clean vehicles per nominal project vehicle, independent of whether target deployment succeeds; same finite window and health coefficient. Separate geographic shares preserve regional harm. Alternative need not literally be a truck purchase. Central target enables 50% of 100 vehicles, displaced alternative 25%; if target fails, alternative loss remains.",
    "costs": "Public values are real implementation inputs excluding transfers; private values are net real cost including capital timing, energy and maintenance versus each project's own baseline, excluding public-paid assets. No double-counted grants, subsidies or asset ownership transfer. Per-decision magnitudes are unpriced analyst assumptions. All per-decision costs are assumed present values at gift date, including the later start and finite acceleration window. Values do not price full vehicle purchase as wholly additional when purchases are merely earlier.",
    "geography": "All health assumed California residents, labeled US for nesting. Bay includes SF. Central 10%/1% are allocation priors informed only loosely by old ACT air-basin pattern, not measured next-gift residence.",
    "timing": "One prospective staff-year allocation, decisions starting after delay. Only finite earlier clean-operation years count; no perpetual ZEV benefits once no-gift fleet catches up. Finite postevent survival is separate; tail times count first unique prevented deaths."
  },
  "unquantified": [
    "Other CCA education, monitoring, climate and policy health",
    "Nonfatal respiratory/cardiovascular morbidity",
    "Noise, collision, congestion and construction harms except displacement/independent-harm stresses",
    "Climate effects outside the air-pollution death branch",
    "Medical spending and general fiscal opportunity costs"
  ],
