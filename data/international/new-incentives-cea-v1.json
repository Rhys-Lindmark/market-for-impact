    "fundedBaselineUrl": "https://www.givewell.org/research/grants/new-incentives-extension-of-support-in-northern-nigeria-march-2025"
  },
  "formulas": {
    "eligibleInfants": "giftUsd*coreAllocation/cashCostPerEligibleCatchmentInfant",
    "deaths": "eligibleInfants*fundingAdditionality*effectiveBundleCoverageIncrease*residualUnvaccinatedDiseaseDeathRisk*bundleDiseaseMortalityEfficacy",
    "lifeQ": "persistentSurvivalFraction*utility*sum(k=1..survivalYears, annualSurvival^(k-.5)/(1+discount)^(k-.5))",
    "calendar": "sum(j=0..3, .25/(1+discount)^(implementationDelayYears+j+1))",
    "netQ": "deaths*lifeQ*calendar - eligibleInfants*fundingAdditionality*sharedHarmQalyPerEligibleInfant/(1+discount)^implementationDelayYears - independentGiftHarmQaly",
    "cashRatio": "10*giftUsd/netQ if netQ>0 else null",
    "grossFiscal": "giftUsd+eligibleInfants*otherResourcesPerEligibleInfant",
    "transferExcludedProxy": "grossFiscal-eligibleInfants*cashTransferPerEligibleInfant"
  },
  "assumptionMeaning": {
    "effectiveBundleCoverageIncrease": "Analyst extra full-course-equivalent mortality-weighted coverage, informed by but NOT equal to any single RCT endpoint. Dose/completion is standardized here once, alongside self-report and modern transport; no second transport or incomplete-series factor.",
    "residualUnvaccinatedDiseaseDeathRisk": "Analyst probability of dying before age5 from bundle-targeted diseases among marginal not-yet-protected infants, after enrollment eligibility and before alternative catch-up. Not national under5 mortality, not all children, not annual risk.",
    "bundleDiseaseMortalityEfficacy": "Analyst efficacy of the standardized full-course equivalent against that disease-death risk; no further incomplete-series reduction. Not allcause RRR or 100% protection.",
    "fundingAdditionality": "Combined nonreplacement of funded duration/other donors and genuinely additional supported core activity, beyond usual public supply. Does not again reduce trial compliance.",
    "cashCost": "Includes staff, incentive transfers, administration, failures and repeat enrollments; quote is for a different enrolled-child denominator and is context only.",
    "resources": "Other public vaccine, clinical, household and donated input allowance, excluded from NI cash. Gross package stress, not measured net societal cost; no health-care savings subtracted.",
    "coreAllocation": "Noncore marginal activity/reserve diversion prior, NOT an overhead haircut: core cost already all-in. Uncredited noncore effects may be positive or negative.",
    "survival": "Finite analyst survival difference with competing mortality, not an observed trial lifetable. Persistent fraction allows early gains not to last; 3yr sensitivity tests postponement.",
    "harm": "Illustrative diagnostics for vaccine/program/crowding harms, not measured incidence or safety bound."
  },
