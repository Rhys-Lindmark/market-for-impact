{
  "model_id": "hpp-whole-gift-maternal-depression-v1",
  "prepared": "2026-09-08",
  "status": "Author-checked conditional research draft; independent acceptance pending; not a verified donor offer",
  "organization": {
    "name": "Homeless Prenatal Program",
    "ein": "94-3146280",
    "giving_url": "https://www.homelessprenatal.org/donate"
  },
  "selection": "Inspected newdoor-portfolio BACKLOG, lib/data/docs and next100 queue. HPP exists in candidate/public-funding universe with older syphilis rejection and prevention hypothesis; no whole-gift HPP report found. This quantifies treatment access for existing maternal depression, not prevention-course efficacy.",
  "boundary": "Every scenario retains the entire unrestricted $100,000 gift. Only a hypothetical maternal depression-treatment component quantified; housing, child health, wellness, violence support, employment and other benefits/harms unquantified. This is not a restricted treatment offer.",
  "service": "Current official site offers onsite/virtual bilingual psychotherapy by therapists, social workers and trainees. Specific perinatal depression protocol, added caseload, current waitlist and discretionary allocation unknown. General support is not assumed to reproduce collaborative stepped depression care.",
  "causal": "Signed incremental depression-free days per clinically eligible person offered a complete supported treatment opportunity, versus actual available care, already includes non-engagement, completion, recurrence, spontaneous recovery and alternative treatment over the finite observation window. No second adherence/remission/catch-up multiplier. Funding additionality separately removes replacement financing.",
  "health": "DFDs are symptom-derived health-time estimates, not preference-valued QALYs. A judgmental utility contrast (central .2, .1–.3 scenarios) converts days to QALYs. Uniform temporal allocation across 548 days is an explicit timing heuristic; daily midpoints discounted once from gift. No health beyond this window, maternal mortality or child lifetime benefit. Shared and independent harms must exclude losses already contained in signed net depression-free days.",
  "cost": "Complete cash per offered eligible person includes therapy, failed recruitment/screening allocated across eligible offers, supervision, navigation, interpretation/childcare/transport support and organizational overhead. Outside resource envelope adds hypothetical medication/psychiatric care/other noncash inputs once on nominal offers, before replacement. Not net social cost; no savings deducted. Donor-paid outside-care scenario moves $500 into cash and removes it from extras.",
  "baseline": "FY2025 audit records $20,534,383 revenue/support, $20,777,163 expense, $12,572,986 program service fees and $6,246,580 restricted net assets. Note7 links service-fee receivables to SF departments. Public rapid-rehousing agreement includes therapist funding through a 2025–2031 planned term. DHCS covered mental health and 2026 transitional care are baseline. None proves a funded maternal therapy seat for every client or an unfunded cohort.",
  "geography": "All modeled health is US. Bay includes SF; priors based on local family focus rather than measured residence. Same partition applied to harms here. Nested ledgers are never added.",
  "harm_timing": "Shared harm per incremental offer and independent harm per gift are already gift-date present-value QALY losses. They receive no further discount and exclude losses already captured in signed net depression-free days.",
  "overlap": "HPP, UCSF/ZSFG, RAMS, Medi-Cal contractors and other family/mental-health agencies cannot each count the same depression-free day. Housing/therapy/support pathways may overlap; no extra maternal/child survival, suicide-prevention or birth-outcome stream credited.",
  "formulas": {
    "offers": "gift*allocation/cashPerOffer",
    "incrementalOffers": "offers*fundingAdditionality",
    "health": "incrementalOffers*(netDFD/365*utility*meanDiscount-sharedHarm)-independentHarm",
    "resources": "gift+nominalOffers*extraResources",
    "ratio": "10*cost/regionQ for regionQ>0, otherwise null"
  },
