{
  "model_id": "sfphf-whole-gift-hcv-navigation-v1",
  "prepared": "2026-09-08",
  "status": "Author-checked conditional research draft; independent acceptance pending; not a verified donor offer",
  "organization": {
    "name": "San Francisco Public Health Foundation",
    "ein": "94-3117093",
    "giving_url": "https://sfphf.allyrafundraising.com/",
    "identity": "Officially hosted 2024 Form 990 for July 1, 2024–June 30, 2025 links name, EIN and sfphf.org. Prepared May 12, 2026; no claim of fresh IRS eligibility verification."
  },
  "service_status": "Live foundation and plausible established navigation pathway: current official site describes ninth peer-navigator cohort; FY2025 audit holds EndHepCSF restricted funds and a March2026 public proposal names the initiative for a different community-assessment scope. Post-June/July2026 navigator staffing and current contract continuation not independently verified. Do not turn the assessment subcontract into treatment or a contract expiry into proof of closure/unfunded need.",
  "boundary": "One unrestricted $100,000 foundation gift. Only hypothetical HCV navigation-to-additional-cure component quantified; all remaining gift cost retained, other health benefits/harms unquantified. End Hep C project donation route is not substituted for general giving.",
  "assumptions": "Every numerical scenario input is an analyst judgment. Cure difference is a prospective navigation-versus-actual-available-care probability among confirmed-viremic people offered support, includes completion/failure, and is not measured SFPHF efficacy. Offered navigation cash includes allocated screening failures, all navigation and partner administration/overhead. No second adherence or overhead multiplier.",
  "health": "Reference QALYs are already discounted lifetime MONARCH-style gains per added cure. A finite 20-year allocation heuristic with weights k^shape/(1+d)^k is normalized to that total; not a rerun of disease progression. Reinfection and EXCESS mortality beyond reference mortality truncate benefit; later cure truncates the relevant fraction. Zero irreversible pre-catchup disease credit after cure; no transmission bonus. Gift-to-cure delay discounted once.",
  "cost": "Core donor package = navigation cash + donor DAA share * extra starts per offer * DAA resource cost/start. Main donor share zero is hypothetical public/insurance payment, not verified new capacity. Gross envelope adds unpriced noncash inputs plus remaining medication cost on nominal offers/starts before funding replacement. Counts medication once; no net-social-cost claim and no subtraction of future medical savings.",
  "funding": "Existing public support, funded clinical partners, other donors and restricted balances form baseline. Financial additionality represents replacement of funded navigation; incremental cure probability separately compares clinical access against actual care. Current discretionary allocation, waitlist and incremental funding gap unmeasured.",
  "geography": "All modeled health US. Bay includes SF; shares are beneficiary-residence priors, not service-location proof. Nested ledgers never summed. Harms use same partition here.",
  "overlap": "Foundation, EndHepCSF, SFAF, GLIDE, SFCHC, Springboard and other providers cannot each claim full same-patient cure/tail. Transfers are not added resources. No new naloxone or opioid-treatment survival stream credited.",
  "formulas": {
    "offers": "G*allocation/(navigationCash+donorDAAShare*startDifference*DAACost)",
    "additionalCures": "offers*cureDifference*fundingAdditionality",
    "health": "additionalCures*referenceQ*retainedNormalizedWeights/(1+discount)^giftToCure - offers*fundingAdditionality*sharedHarm - independentHarm",
    "resources": "gift + offers*(extraResource + (1-donorDAAShare)*startDifference*DAACost)",
    "ratio": "10*cost/regionQ if regionQ>0 else null"
  },
