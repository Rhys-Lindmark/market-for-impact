  "allocationBasis": "Judgmental unrestricted portfolio; all100K costed. Required staff/management/fundraising for physical implementation included in60K; other shared reserve not a second charge. Only physical street safety quantified; allocation weights are not audited program budgets.",
  "historicalFinance": {
    "period": "July1,2024–June30,2025",
    "source": "https://walksf.org/wp-content/uploads/2026/05/wsff-24-25-taxfinal-990.public.pdf",
    "type": "Provider-posted Form990, not audited financial statements",
    "expenses": 981449,
    "programExpenses": 513353,
    "managementGeneral": 252527,
    "fundraising": 215569,
    "revenue": 894475,
    "netAssets": 885931,
    "meaning": "Gift is about10% historicalexpense. Historical gains and financial deficit are not marginal attribution or room."
  },
  "unit": "Whole gift's60K physical-street work may accelerate one hypothetical bundled SF traffic-calming package. No specific unfunded project or risk-targeted street list verified. Other campaigns unquantified, not assumed valueless.",
  "mechanism": "Non-electoral engineering implementation advocacy, resident engagement and accountability leading to additional early traffic-calming; NOT education alone, speed-limit signs alone, already funded cameras, or a new claim on citywide fatality decline.",
  "additionalityMeaning": "p is the joint probability that this gift-funded work causes a package to open earlier than no-gift public/coalition baseline, including failure, donor replacement and other advocates. Conditional benefit then applies for delayYears before baseline catches up. No additional funding multiplier or second60% multiplier.",
  "overlap": "Package street exposure must be disjoint from other funded projects/cameras and SPUR/transit claims. Fatal and nonfatal severe casualties separate. Injury reductions are net of displacement and shared transport harms in positive priors; independently caused donor harm separate. No activity, air-quality, survivor distress or citywide policy add-on.",
  "geography": "Events occur on SF streets, but people need not reside inSF. Explicit SF/restBay/outsideBay shares sum1. OutsideBay benefit excluded from Bay and SF headline. Bay includesSF; same100K gift. No inference that every street user is local.",
  "duration": "Open package at beginning startYear; count incremental risk reduction in years startYear..startYear+delayYears−1 only, event impacts dated endyear. No-gift package arrives afterdelay. Death QALYtail finite15/30/40years; severe tail1/3/5years. Discount at3% once for eventdate and once within subsequent health trajectory (different time intervals).",
  "formulas": {
    "fatalQPerAvertedDeath": "sum(k=1..fatalHorizonYears) baselineUtility*exp(-competingHazard*(k−.5))/(1.03)^k",
    "nonfatalQPerAvertedInjury": "sum(k=1..severeDurationYears) severeUtilityLoss/(1.03)^k; injury category and duration judgments, not measuredSFutility",
    "eventWindowPV": "sum(t=startYear..startYear+delayYears−1)(1.03)^(-t)",
    "health": "grossAllRecipientQ=p*targetRiskShare*eventWindowPV*(annualFatalities*fatalRRR*fatalQ+annualSevereNonfatal*severeRRR*severeQ); geographical shares then independent donor harm",
    "donorCost": "entire100K in allcases; ratio10*100K/netQ onlyifpositive",
    "timingResourceCost": "100K +p*[packageCapital*((1.03)^(-(startYear−1))−(1.03)^(-(startYear+delayYears−1))) + annualMaintenance*eventWindowPV]. Narrow matched-build timing comparison, not fullsocialcost; assumes samecapital otherwise incurred later.",
    "grossResourceStress": "100K+p*packageCapital/(1.03)^(startYear−1)+p*annualMaintenance*eventWindowPV. Charges expected earlycapitalwithoutcrediting laterbaselinebuild; conservativegross-forward envelope, not netincremental societalcost."
  },
