{
  "schema_version": "research-portfolio-v1",
  "model_id": "end-overdose-whole-portfolio-v1",
  "prepared_at": "2026-09-08",
  "status": "Accepted conditional research model after independent arithmetic audit; primary filing identity verified September 8, 2026; not a verified donation recommendation",
  "organization": {
    "name": "End Overdose",
    "identity": "Organization-filed 2024 Form 990, submitted March 25, 2025 and inspected in ProPublica's rendering of IRS data, identifies END OVERDOSE, EIN 83-0696963 and endoverdose.net. This verifies filing identity, not a fresh IRS eligibility audit. Distinct from End Native Overdose, SFAF, DOPE and FentCheck.",
    "geography": "National US organization with verified SF activity and Bay chapters; not an SF-only recipient."
  },
  "gift_boundary": "One $100,000 unrestricted gift, spent once. All scenarios are conditional marginal allocations, not observed budgets. Only naloxone-training delivery health is quantified; the rest remains costed.",
  "unit": "One offered training-plus-twin-pack package within a one-year delivery window. All offers are fully costed including failures, training platform, staff, fulfillment, shipping and implementation overhead. Two doses are one kit, not two recipient rescues.",
  "cost_status": "$19 per twin-pack is a primary California procurement benchmark, not EO invoice or automatically available nationwide. All operating prices and national transfer are analyst judgments. Core central cash $19 stock + $31 operations; favorable $19+$16; pessimistic $45+$55. Assumes no beneficiary shipping revenue; conservatively cash-finances stock. Hypothetical donated-stock sensitivity explicitly moves stock to resource cost.",
  "assumption_status": "All health and allocation inputs are explicit analyst priors, not source-measured effect estimates. Published community evidence supports plausibility but does not identify marginal EO rescue rates or utility.",
  "formula": {
    "offers": "G*core_fraction/(kit_cash_usd+operations_cash_usd)",
    "finite_qaly_per_death": "sum k=1..T [survival_utility*(1-annual_competing_mortality)^k/(1+discount_rate)^k]",
    "deaths": "offers*encounter_probability*unique_scene_factor*incremental_timely_rescue_probability*mortality_risk_reduction_given_extra_rescue*funding_additionality",
    "global_qaly": "deaths*finite_qaly_per_death/(1+discount_rate)^event_delay_years - funding_additionality*shared_harm_qaly - donor_specific_harm_qaly",
    "bay_qaly": "global_qaly*(sf_health_share+rest_bay_health_share)",
    "sf_qaly": "global_qaly*sf_health_share",
    "gross_resource": "G + offers*(unpaid_resource_per_offer_usd+donated_stock_resource_per_offer_usd)",
    "usd_per_10": "10*cost/Q if Q>0, otherwise null"
  },
  "definitions": {
    "encounter_probability": "Probability a prospective trainee has at least one qualifying opioid-overdose rescue opportunity within one year; not an annualized historical reversal count.",
    "unique_scene_factor": "Reduction for multiple trained witnesses of the same episode and repeated rescued recipients; aggregate credit must be first unique-person survival only. This is a conservative bookkeeping prior, not an observed deduplication rate.",
    "incremental_timely_rescue_probability": "Conditional probability the offered package adds timely naloxone administration, including completion, delivery, usable kit availability and carriage, beyond ordinary bystander/EMS rescue. No extra adherence factor is multiplied.",
    "mortality_risk_reduction_given_extra_rescue": "Absolute mortality reduction for an episode receiving genuinely additional timely administration versus the same episode without it, retaining other ordinary care. Not the proportion of reversals surviving.",
    "funding_additionality": "Share of nominal package activity genuinely added by gift versus replacement of other funding. Separate from clinical rescue substitution, not an additional discount for the same kit-access alternative.",
    "health_schedule": "Rescue at end of year 1, followed by finite annual survival/utility flows for 30 central, 40 favorable or 15 pessimistic years. Those are explicit trajectories, not measured age-matched life expectancies. The opportunity period is only one year, not device shelf life.",
    "geography": "Explicit unmeasured beneficiary-residence shares. All/global means US health only; Bay includes SF and must not be added. Training/event/chapter location is not beneficiary residence.",
    "shared_harm_qaly": "All-recipient present-valued health harm conditional on package implementation before funding additionality. Not monetary opportunity cost.",
    "donor_specific_harm_qaly": "Gift-specific actual health harm independent of whether package activity is additional. Geography assumed same as benefit shares in this diagnostic; revise if evidence differs.",
    "gross_resource": "Gross package spending envelope including unpaid labor/other inputs. Not net induced social opportunity cost. At zero funding additionality gift and gross resource envelope remain, although net incremental public use can be zero."
  },
  "unquantified": [
    "Other prevention and public-awareness work",
    "Fentanyl test-strip benefit",
    "Chapter and school spillovers beyond counted rescues",
    "Nonfatal morbidity prevented",
    "Welfare and medical savings"
  ],
  "funding_and_overlap": "Current free EO kit and NDP public supply are major baseline substitutes. No EO stock funding source, current donor tranche, wait-list, marginal demand or SF restriction verified. Never add the same public twin-pack, rescue or person-survival effect to SFAF, DOPE or FentCheck ledgers.",
