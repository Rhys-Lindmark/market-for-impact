  "modelId": "remedy-alliance-general-gift-representative-naloxone-core-v1",
  "organization": "Remedy Alliance / For The People",
  "ein": "87-3486445",
  "status": "Independently audited conditional research model; publication pending",
  "givingScope": "General organizational donation, represented by naloxone access core with explicit allocation prior. Real statewide CA NDP partner and national supplier; not CA-restricted giving or extra credit for already funded NDP contracts.",
  "giftUsd": 10000,
  "unit": "Standardized four-injectable-dose-equivalent supply bundle, procurement-accounting unit only; NOT a clinical dosing recommendation or claim each overdose needs four doses. Costs, reach and response probability defined per bundle, not per vial.",
  "sources": {
    "actualProgram": "https://remedyallianceftp.org/",
    "giving": "https://givebutter.com/ScOTky",
    "caPublicBaseline": "https://www.dhcs.ca.gov/individuals/naloxone-distribution-project/products-available-through-the-ndp-2/",
    "historicalPrice": "https://remedyallianceftp.org/blogs/news/remedy-alliance-for-the-people-distributes-over-1-million-doses-of-naloxone-in-the-first-10-months-of-operation",
    "nativeObservation": "https://journals.plos.org/plosone/article?id=10.1371/journal.pone.0315026",
    "causalContext": "https://pubmed.ncbi.nlm.nih.gov/23372174/"
  },
  "geography": {
    "programReach": "California statewide partnership and broader US network",
    "sfMarginalHealthShare": null,
    "bayMarginalHealthShare": null,
    "californiaMarginalHealthShare": null,
    "outsideCaliforniaMarginalHealthShare": null,
    "indirectHealthCredited": 0,
    "meaning": "Unknown residence allocation. CA warehouse/purchasing address is not beneficiary location. Mechanical positive-health share range0..1 is not an informative empirical bound; SF<=Bay<=CA<=1. Full gift remains numerator."
  },
  "formulas": {
    "bundles": "giftUsd*coreAllocation/cashPerBundle",
    "lifeQ": "utility*sum(k=1..survivalYears,annualSurvival^(k-.5)/(1+discount)^(k-.5))",
    "netQ": "bundles*fundingOutputAdditionality*(responseProbabilityWithinYear*survivalDifferencePerResponse*lifeQ-sharedHarmPerBundle)/(1+discount)^(delayYears+.5)-independentGiftHarm",
    "grossResource": "giftUsd+bundles*externalLastMileResourcePerBundle",
    "ratio": "10*cost/netQ if netQ>0 else null"
  },
  "assumptions": {
    "coreAllocation": "Judgment marginal core share, not program-expense ratio or second overhead haircut. Core cash already all-in. Other activity benefits uncredited, not biological zero.",
    "responseProbabilityWithinYear": "Judgment qualifying nonduplicated overdose-response equivalents per funded bundle within12months; events are deduplicated across ALL funded bundles, so multiple bundles at one scene share one event credit. Includes failed last-mile reach, nonuse, expiration and repeat supply. No second reached/used multiplier; at most one event-equivalent credit per bundle.",
    "survivalDifferencePerResponse": "Judgment person-linked marginal first-rescue-equivalent survival probability per qualifying event, retaining EMS, rescue breathing and other timely naloxone AND overlap when the same person has separate rescues. The product with finiteSurvivalQaly is marginal nonoverlapping person-time, not a new full five-year tail after every rescue. Not a raw acute survival rate or fatality among all overdoses.",
    "fundingOutputAdditionality": "Judgment genuinely additional core supply beyond public/other-donor and cross-subsidy replacement. Distinct from event-level alternative rescue. No extra credit for funded CA NDP orders.",
    "survival": "Finite five-year survival-equivalent difference with recurrent overdose/other competing mortality. Annual survival .9 does NOT itself remove overlapping credits from separate rescues of the same person; that person-linked deduplication is in survivalDifferencePerResponse. Not lifelong benefit from every reversal. Model survival probability is a judgment.",
    "cost": "Judgment all-in donor cash; historical drug price not current quote. External last-mile allowance is gross associated resource stress not net societal incremental cost, especially at replacement null.",
    "harm": "Diagnostic assumed QALY losses, not observed adverse-event incidence. Shared harms scale replacement; independent gift harm may persist.",
    "geography": "No invented SF spillover; beneficiary-share stresses require explicit chosen share and do not establish it."
  },
