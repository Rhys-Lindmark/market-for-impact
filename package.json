{
  "name": "market-for-impact",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "data:coefficient": "node scripts/ingest-coefficient.mjs",
    "data:coefficient:check": "node scripts/refresh-coefficient.mjs",
    "data:coefficient:refresh": "node scripts/refresh-coefficient.mjs --write && node scripts/ingest-coefficient.mjs",
    "data:coefficient:all:check": "node scripts/refresh-coefficient-all.mjs",
    "data:coefficient:all:refresh": "node scripts/refresh-coefficient-all.mjs --write",
    "data:givewell": "node scripts/ingest-givewell.mjs",
    "data:ace:check": "node scripts/refresh-ace.mjs",
    "data:ace:refresh": "node scripts/refresh-ace.mjs --write",
    "data:giving-green:check": "node scripts/refresh-giving-green.mjs",
    "data:giving-green:refresh": "node scripts/refresh-giving-green.mjs --write",
    "data:founders-pledge:check": "node scripts/refresh-founders-pledge.mjs",
    "data:founders-pledge:refresh": "node scripts/refresh-founders-pledge.mjs --write",
    "data:ai-safety:check": "node scripts/build-ai-safety-ecosystem.mjs",
    "data:ai-safety:build": "node scripts/build-ai-safety-ecosystem.mjs --write",
    "data:evaluator-comparison:check": "node scripts/build-evaluator-comparison.mjs",
    "data:evaluator-comparison:build": "node scripts/build-evaluator-comparison.mjs --write",
    "data:funding-tranches:check": "node scripts/build-funding-tranches.mjs",
    "data:funding-tranches:build": "node scripts/build-funding-tranches.mjs --write",
    "data:grant-flows:check": "node scripts/build-grant-flow-contract.mjs",
    "data:grant-flows:build": "node scripts/build-grant-flow-contract.mjs --write",
    "data:quality:check": "node scripts/build-data-quality-contract.mjs",
    "data:quality:build": "node scripts/build-data-quality-contract.mjs --write",
    "data:portfolio:check": "node scripts/build-portfolio-contract.mjs",
    "data:portfolio:build": "node scripts/build-portfolio-contract.mjs --write",
    "data:sf:check": "node scripts/validate-sf-outcomes.mjs",
    "data:sf:sources": "node scripts/refresh-sf-outcomes.mjs",
    "data:sf:funding:check": "node scripts/validate-sf-public-funding.mjs",
    "data:sf:funding:sources": "node scripts/refresh-sf-public-funding.mjs",
    "data:sf:funding:refresh": "node scripts/refresh-sf-public-funding.mjs --write",
    "data:sf:diligence:check": "node scripts/build-sf-nonprofit-diligence.mjs",
    "data:sf:diligence:build": "node scripts/build-sf-nonprofit-diligence.mjs --write",
    "data:charity-navigator:check": "node scripts/refresh-charity-navigator.mjs",
    "data:charity-navigator:refresh": "node scripts/refresh-charity-navigator.mjs --write",
    "data:renphil:check": "node scripts/refresh-renphil.mjs",
    "data:renphil:refresh": "node scripts/refresh-renphil.mjs --write",
    "test": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.2",
    "@cloudflare/workers-types": "5.20260830.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "wrangler": "4.127.1"
  },
  "type": "module"
}
